# Copy this file to .env and fill in the real values. .env is never uploaded (see .gitignore).

# Odoo BI sales endpoint (without ?date_from=... — the program adds date_from, date_to, limit, offset)
ODOO_API_URL=https://your-odoo-host/api/bi/v1/pos/sales/detail

# Bearer token for that endpoint (only the token, without the word "Bearer")
ODOO_API_TOKEN=your-token

# Optional: GCC time zone of the dashboard (default Asia/Riyadh = UTC+3). The API works in UTC; the
# program converts, e.g. the GCC day 2026-10-01 = 2026-09-30 21:00:00 .. 2026-10-01 20:59:59 UTC.
# Asia/Dubai or Asia/Muscat = UTC+4.
# ODOO_TZ=Asia/Riyadh

# TESTING ONLY: fixed GCC date range (YYYY-MM-DD) instead of "1st of this month .. today".
# Leave empty (or delete) for the live dashboard. Either one alone also works:
# only FROM = from that day to today; only TO = from the 1st of that month to that day.
SALES_DATE_FROM=
SALES_DATE_TO=
